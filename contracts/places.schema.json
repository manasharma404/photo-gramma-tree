{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "places.geojson: settlements and facilities (incl. landing zones), EPSG:4326. Population is filled by the teammate.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "mock": {"type": "boolean"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": {"const": "Feature"},
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"const": "Point"},
              "coordinates": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}}
            }
          },
          "properties": {
            "type": "object",
            "required": ["mock", "place_id", "name", "kind", "source", "population", "population_source", "nearest_segment_id"],
            "properties": {
              "mock": {"type": "boolean"},
              "place_id": {"type": "string"},
              "name": {"type": ["string", "null"]},
              "kind": {"enum": ["settlement", "hospital", "school", "shelter", "landing_zone", "other_facility"]},
              "source": {"enum": ["osm", "landing_zones", "manual"]},
              "population": {"type": ["integer", "null"]},
              "population_source": {"type": "string", "description": "Citation, or PLACEHOLDER"},
              "nearest_segment_id": {"type": ["string", "null"], "description": "Where the place joins the road graph"}
            }
          }
        }
      }
    }
  }
}
