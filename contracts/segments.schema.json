{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "segments.geojson: road segments (<= 50 m) with status per vehicle type, EPSG:4326",
  "type": "object",
  "required": ["type", "features"],
  "$defs": {
    "num": {"type": ["number", "null"]},
    "status": {"enum": ["open", "partial", "blocked", "unknown"]}
  },
  "properties": {
    "type": {"const": "FeatureCollection"},
    "mock": {"type": "boolean"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": {"const": "Feature"},
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"const": "LineString"},
              "coordinates": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}}}
            }
          },
          "properties": {
            "type": "object",
            "required": ["mock", "segment_id", "osm_way_id", "highway", "length_m", "corridor_width_m", "corridor_width_source",
                         "coverage_fraction", "max_obstruction_m", "obstructed_length_m", "min_clear_width_m",
                         "debris_volume_m3", "debris_volume_tolerance_m3", "ml", "measured"],
            "properties": {
              "mock": {"type": "boolean"},
              "segment_id": {"type": "string"},
              "osm_way_id": {"type": ["integer", "null"]},
              "highway": {"type": "string"},
              "length_m": {"$ref": "#/$defs/num"},
              "corridor_width_m": {"$ref": "#/$defs/num"},
              "corridor_width_source": {"enum": ["osm_tag", "default_by_class(PLACEHOLDER)"]},
              "coverage_fraction": {"$ref": "#/$defs/num"},
              "max_obstruction_m": {"$ref": "#/$defs/num"},
              "obstructed_length_m": {"$ref": "#/$defs/num"},
              "min_clear_width_m": {"$ref": "#/$defs/num"},
              "debris_volume_m3": {"$ref": "#/$defs/num"},
              "debris_volume_tolerance_m3": {"$ref": "#/$defs/num"},
              "status_by_mode": {
                "description": "Optional. The authoritative status per vehicle comes from GET /advisor/state (assessment engine).",
                "type": "object",
                "required": ["fire_truck", "ambulance", "jeep", "foot"],
                "additionalProperties": {"$ref": "#/$defs/status"}
              },
              "ml": {
                "type": "object",
                "required": ["p_blocked", "model"],
                "properties": {"p_blocked": {"$ref": "#/$defs/num"}, "model": {"type": ["string", "null"]}}
              },
              "decision": {"enum": ["geometry", "ml", "agree", "disagree_review"]},
              "measured": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
