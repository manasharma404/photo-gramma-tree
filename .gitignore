# Data stays out of git (raw footage, public datasets, ODM outputs are huge).
# Anchored with a leading slash so folders like web/src/data are NOT ignored.
/data/*
!/data/LICENSES.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Web
node_modules/
web/dist/
web/dist-snapshot/

# Neo4j (teammate) runtime folders
neo4j/data/
neo4j/plugins/
neo4j/logs/

# Tool caches and local tooling
/cache/
/.claude/

# Secrets
.env
